# Optional: enables the "Pregunta" agent (/api/ask). Without it the app still works with deterministic findings.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Mercado Público (ChileCompra) API ticket — free, request it with ClaveÚnica at https://www.chilecompra.cl/api/
MERCADOPUBLICO_TICKET=

# Banco Central de Chile BDE API — free registration at https://si3.bcentral.cl/estadisticas/Principal1/Web_Services/index_API_sec1_es.htm
BCCH_USER=
BCCH_PASS=
# CPI series used to convert to real pesos (check the code in the BDE series catalogue before the first run)
BCCH_CPI_SERIES=F074.IPC.IND.Z.EP23.C.M

# demo | live. In "live", pages read only data/store (ingested + verified). In "demo", fictional fixtures fill domains not yet ingested, always labelled "Ejemplo".
DATA_MODE=demo
